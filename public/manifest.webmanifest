{
  "id": "/",
  "name": "Schnitzeljagd Sprach-Chat",
  "short_name": "Schnitzeljagd",
  "description": "Eine WhatsApp-Style Chat-App mit Sprachnachrichten von Mortimer Morrison für eine Kindergeburtstags-Schnitzeljagd.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "theme_color": "#075e54",
  "background_color": "#111b21",
  "icons": [
    {
      "src": "./pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
